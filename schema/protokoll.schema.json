{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professorquantumuniverse.github.io/SV/schema/protokoll.schema.json",
  "title": "SV-Protokoll",
  "description": "Ein Sitzungsprotokoll der SV FWS Frankfurt – exakt das Format, das der Generator exportiert und importiert.",
  "type": "object",
  "required": [
    "meetingDate",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "description": "Kennung des Dateiformats. Optional, wird beim Export gesetzt.",
      "const": "sv-protokoll"
    },
    "version": {
      "description": "Version des Dateiformats. Optional, wird beim Export gesetzt.",
      "const": 1
    },
    "meetingDate": {
      "description": "Datum der Sitzung (YYYY-MM-DD). Erscheint im Titel.",
      "$ref": "#/$defs/date"
    },
    "printDate": {
      "description": "Erstellungsdatum des Protokolls (YYYY-MM-DD). Erscheint in der Fußzeile.",
      "$ref": "#/$defs/date"
    },
    "author": {
      "description": "Vollständiger Name der protokollierenden Person. Erscheint in der Fußzeile.",
      "type": "string",
      "maxLength": 120
    },
    "location": {
      "description": "Ort der Sitzung, optional (z. B. \"SV-Raum\").",
      "type": "string",
      "maxLength": 120
    },
    "timeFrom": {
      "description": "Beginn der Sitzung (HH:MM, 24 h), optional.",
      "$ref": "#/$defs/time"
    },
    "timeTo": {
      "description": "Ende der Sitzung (HH:MM, 24 h), optional.",
      "$ref": "#/$defs/time"
    },
    "attendance": {
      "description": "Anwesende je Klasse. Wert: Vornamen, durch Komma getrennt. Klassen ohne Anwesende weglassen.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "7A",
          "7B",
          "8A",
          "8B",
          "9A",
          "9B",
          "10A",
          "10B",
          "11A",
          "11B",
          "12A",
          "12B",
          "13A",
          "13B"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "sections": {
      "description": "Die Protokollpunkte in Sitzungsreihenfolge. Die Titel ergeben automatisch die Themenliste.",
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^(\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))?$",
      "description": "Datum im Format YYYY-MM-DD (oder leer)"
    },
    "time": {
      "type": "string",
      "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d)?$",
      "description": "Uhrzeit im Format HH:MM, 24 h (oder leer)"
    },
    "count": {
      "description": "Stimmenzahl: ganze Zahl ≥ 0, leer = nicht erhoben.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d*$",
          "description": "Stimmenzahl nur als Ziffern (oder leer)"
        },
        {
          "type": "null"
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Interne ID. Optional – fehlt sie, vergibt der Generator eine.",
          "type": "string"
        },
        "title": {
          "description": "Kurzer Titel des Punkts, ohne abschließenden Doppelpunkt.",
          "type": "string",
          "maxLength": 80
        },
        "text": {
          "description": "Fließtext. Leerzeile (\\n\\n) = neuer Absatz, \\n = Zeilenumbruch. Keine Formatierung (kein Markdown).",
          "type": "string",
          "maxLength": 20000
        },
        "votes": {
          "description": "Optionale Abstimmungstabelle. Das Ergebnis berechnet der Generator selbst.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/votes"
            }
          ]
        }
      }
    },
    "votes": {
      "type": "object",
      "required": [
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "caption": {
          "description": "Überschrift der Tabelle, optional (z. B. \"Abstimmung zur SV-Aktion\").",
          "type": "string",
          "maxLength": 120
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "description": "Worüber abgestimmt wurde (Antrag/Option).",
                "type": "string",
                "maxLength": 200
              },
              "yes": {
                "$ref": "#/$defs/count"
              },
              "no": {
                "$ref": "#/$defs/count"
              },
              "abstain": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    }
  }
}
